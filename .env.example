# FontAwesome Pro — obtenha seu token em https://fontawesome.com/account
FA_TOKEN=seu_token_aqui

# /whatsapp/estados — lista de links das telas do fluxo de autenticação via
# WhatsApp, usada em apresentação. Fica disponível por padrão; para esconder
# num ambiente real, defina como "false".
# VITE_MOSTRAR_TELAS=false

# Retorno automático para o wa.me ao fim da contagem na tela "Identidade
# confirmada". Só ligar quando whatsappNumero (src/config/autenticacao.ts)
# apontar para o número real do atendimento.
# VITE_RETORNO_AUTOMATICO=true

# Quando integrado à API real, adicionar aqui:
# VITE_API_URL=https://api.exemplo.com
# VITE_GOVBR_CLIENT_ID=seu_client_id
